@model  Prelims.Models.HomeViewModel

@{
    ViewBag.Title = "Prelims";
}

<div class="header-box" style="display: flex; align-items: center; justify-content: space-between;">
    <span class="header-text">DASH BOARD</span>
    <div style="display: flex; align-items: center;">
        @if (ViewBag.IsLoggedIn == true && ViewBag.ActiveTime != null)
        {
            <span style="border: 2px solid #e8a317; padding: 4px 12px; font-size: 13px; color: #333; background-color: #fffbe6; margin-right: 8px;">
                You have been active for <span id="activeHours">@ViewBag.ActiveTime.Hours</span> hours and <span id="activeMinutes">@ViewBag.ActiveTime.Minutes</span> minutes
            </span>
            @Html.ActionLink("Logout", "End", "UserTimeEntries", new { entryId = @ViewBag.ActiveEntryId }, new { @class = "btn btn-warning", style = "font-size: 13px;" })
        }
        else
        {
            @Html.ActionLink("Login", "Start", "UserTimeEntries", new { }, new { @class = "btn btn-success", style = "font-size: 13px;" })
        }
    </div>
</div>

@if (ViewBag.IsLoggedIn == true && ViewBag.ActiveTime != null)
{
    <script>
        (function () {
            var hours = @ViewBag.ActiveTime.Hours;
            var minutes = @ViewBag.ActiveTime.Minutes;

            setInterval(function () {
                minutes++;
                if (minutes >= 60) {
                    minutes = 0;
                    hours++;
                }
                var hoursEl = document.getElementById('activeHours');
                var minutesEl = document.getElementById('activeMinutes');
                if (hoursEl) hoursEl.textContent = hours;
                if (minutesEl) minutesEl.textContent = minutes;
            }, 60000);
        })();
    </script>
}

<div class="row dashboard-section">
    <div class="col-md-12">
        <h3 class="section-title">Live Status</h3>
        @foreach (var liveStatusGroup in Model.LiveStatusItems.GroupBy(x => x.GroupName))
        {
            var liveStatusTable = "liveStatusTable" + liveStatusGroup.Key.Replace(" ", "");

            <div id="@liveStatusTable" class="status-group" ng-init="@liveStatusTable=false">
                <div>

                    <div class="status-group-toggle" ng-click="@liveStatusTable=!@liveStatusTable">
                        <i class="glyphicon glyphicon-chevron-right" ng-if="!@liveStatusTable"></i>
                        <i class="glyphicon glyphicon-chevron-down" ng-if="@liveStatusTable"></i>
                        @liveStatusGroup.Key
                    </div>
                </div>
                <table class="table table-condensed status-table" ng-if="@liveStatusTable" style="margin-top: 5px;">
                    <tr>
                        <th>
                        </th>
                        <th colspan="3" style="text-align:center;">
                            Taxes
                        </th>
                        <th colspan="3" style="text-align:center;">
                            L&amp;V
                        </th>
                        <th colspan="3" style="text-align:center;"> PI </th>
                        <th colspan="3" style="text-align:center;">GI</th>
                        <th colspan="3" style="text-align:center;">Starter</th>
                        <th colspan="3" style="text-align:center;">Notes</th>
                        <th></th>
                        <th></th>
                    </tr>
                    <tr>
                        <th>
                        </th>
                        <th style="text-align:center;">
                            Refi
                        </th>
                        <th style="text-align:center;">Resale</th>
                        <th class="col-total">Total</th>
                        <th style="text-align:center;">
                            Refi
                        </th>
                        <th style="text-align:center;">Resale</th>
                        <th class="col-total">Total</th>
                        <th style="text-align:center;">Refi</th>
                        <th style="text-align:center;">Resale</th>
                        <th class="col-total">Total</th>
                        <th style="text-align:center;">Refi</th>
                        <th style="text-align:center;">Resale</th>
                        <th class="col-total">Total</th>
                        <th style="text-align:center;">Refi</th>
                        <th style="text-align:center;">Resale</th>
                        <th class="col-total">Total</th>
                        <th style="text-align:center;">Refi</th>
                        <th style="text-align:center;">Resale</th>
                        <th class="col-total">Total</th>
                        <th style="text-align:center;">Hold</th>
                        <th class="col-total">Total</th>
                    </tr>
                    @foreach (var item in liveStatusGroup)
                    {
                        <tr>
                            <th>
                                @item.OfficeName
                            </th>
                            <th style="text-align:center;">
                                @item.TaxesSellerCount
                            </th>
                            <th style="text-align:center;">@item.TaxesBuyerCount</th>
                            <th class="col-total">@item.TaxesCount</th>
                            <th style="text-align:center;">
                                @item.LVSellerCount
                            </th>
                            <th style="text-align:center;">@item.LVBuyerCount</th>
                            <th class="col-total">@item.LVCount</th>
                            <th style="text-align:center;">
                                @item.PISellerCount
                            </th>
                            <th style="text-align:center;">@item.PIBuyerCount</th>
                            <th class="col-total">@item.PICount</th>
                            <th style="text-align:center;">
                                @item.GISellerCount
                            </th>
                            <th style="text-align:center;">@item.GIBuyerCount</th>
                            <th class="col-total">@item.GICount</th>
                            <th style="text-align:center;">
                                @item.StarterSellerCount
                            </th>
                            <th style="text-align:center;">@item.StarterBuyerCount</th>
                            <th class="col-total">@item.StarterCount</th>
                            <th style="text-align:center;">
                                @item.NotesSellerCount
                            </th>
                            <th style="text-align:center;">@item.NotesBuyerCount</th>
                            <th class="col-total">@item.NotesCount</th>

                            <th style="text-align:center;">@item.HoldCount</th>
                            <th class="col-total">@(item.TaxesCount + item.LVCount + item.PICount + item.GICount + item.StarterCount + item.NotesCount)</th>
                        </tr>

                    }

                    <tr class="row-total">
                        <th>
                            Total
                        </th>
                        <th style="text-align:center;">
                            @(liveStatusGroup.Sum(x => x.TaxesSellerCount))
                        </th>
                        <th style="text-align:center;"> @(liveStatusGroup.Sum(x => x.TaxesBuyerCount))</th>
                        <th class="col-total" style="text-align:center;">@(liveStatusGroup.Sum(x => x.TaxesCount)) </th>
                        <th style="text-align:center;">
                            @(liveStatusGroup.Sum(x => x.LVSellerCount))
                        </th>
                        <th style="text-align:center;"> @(liveStatusGroup.Sum(x => x.LVBuyerCount))</th>
                        <th class="col-total" style="text-align:center;">@(liveStatusGroup.Sum(x => x.LVCount)) </th>
                        <th style="text-align:center;">
                            @(liveStatusGroup.Sum(x => x.PISellerCount))
                        </th>
                        <th style="text-align:center;">@(liveStatusGroup.Sum(x => x.PIBuyerCount)) </th>
                        <th class="col-total" style="text-align:center;">@(liveStatusGroup.Sum(x => x.PICount)) </th>
                        <th style="text-align:center;">
                            @(liveStatusGroup.Sum(x => x.GISellerCount))
                        </th>
                        <th style="text-align:center;">@(liveStatusGroup.Sum(x => x.GIBuyerCount)) </th>
                        <th class="col-total" style="text-align:center;">@(liveStatusGroup.Sum(x => x.GICount)) </th>
                        <th style="text-align:center;">
                            @(liveStatusGroup.Sum(x => x.StarterSellerCount))
                        </th>
                        <th style="text-align:center;">@(liveStatusGroup.Sum(x => x.StarterBuyerCount)) </th>
                        <th class="col-total" style="text-align:center;">@(liveStatusGroup.Sum(x => x.StarterCount)) </th>
                        <th style="text-align:center;">
                            @(liveStatusGroup.Sum(x => x.NotesSellerCount))
                        </th>
                        <th style="text-align:center;">@(liveStatusGroup.Sum(x => x.NotesBuyerCount)) </th>
                        <th class="col-total" style="text-align:center;">@(liveStatusGroup.Sum(x => x.NotesCount)) </th>

                        <th style="text-align:center;">@(liveStatusGroup.Sum(x => x.HoldCount)) </th>
                        <th class="col-total" style="text-align:center;">@((liveStatusGroup.Sum(x => x.TaxesCount) + liveStatusGroup.Sum(x => x.LVCount) + liveStatusGroup.Sum(x => x.PICount) + liveStatusGroup.Sum(x => x.GICount) + liveStatusGroup.Sum(x => x.StarterCount) + liveStatusGroup.Sum(x => x.NotesCount)))</th>
                    </tr>

                </table>


            </div>
        }
     </div>
</div>

<div class="row dashboard-section">
    <div class="col-md-12">
        <h3 class="section-title">My Orders</h3>
        <table class="table table-condensed table-striped">
            <tr>
                <th>
                    SL No
                </th>
                <th>
                    Order Number
                </th>
                <th>County</th>
                <th> Office Name </th>
                <th>Order Type</th>
                <th>Priority</th>
                <th>Task</th>
                <th>Received Date Time</th>
                <th>
                    <div class="pull-right">
                        <i class="fa fa-file-excel-o exportToExcelButton" table-id="myOrdersTable" title="Export to Excel" aria-hidden="true" file-name="MyOrders"></i>
                    </div>
                </th>
            </tr>
            @{ var myOrderSerialNumberIndex = 1; }
            @foreach (var item in Model.MyOrders)
            {
                <tr>
                    <td style="text-align:center;">
                        @myOrderSerialNumberIndex.ToString()
                    </td>
                    <td>
                        @if (ViewBag.InprogressTitleOrderId != null)
                        {
                            <span>@item.OrderNo</span>
                        }
                        else
                        {
                            @Html.ActionLink(@item.OrderNo, "Production", "Audits", new { id = item.Id }, new { })
                        }
                    </td>
                    <td>@item.COUNTYNAME</td>
                    <td>
                        @item.CRNDISPLAYNAME
                    </td>
                    <td>
                        @item.TitleOrderRequestTypeName
                    </td>
                    <td>
                        @if (item.IsRushOrder ?? false)
                        {
                            <span class="priority-badge priority-rush">Rush</span>
                        }
                        else
                        {
                            <span class="priority-badge priority-normal">Normal</span>
                        }
                    </td>
                    <td>
                        @item.TitleOrderTaskName
                    </td>
                    <td>
                        @item.ReceivedDateTime
                    </td>
                    <td></td>
                </tr>

                myOrderSerialNumberIndex++;
            }
        </table>
    </div>
</div>

<div class="row dashboard-section">
    <div class="col-md-12">
        <h3 class="section-title">In Progress Orders</h3>
        <table class="table table-condensed table-striped">
            <tr>
                <th>
                    SL No
                </th>
                <th>
                    Order Number
                </th>
                <th> Office Name </th>
                <th>Type</th>
                <th>Task</th>
                <th>Recieved Date Time</th>
                <th>User Name</th>
                <th>Start Time</th>
                <th>Priority</th>
            </tr>
            @{  var serialNumberIndex = 1;  }
            @foreach (var item in Model.InprogressAudits)
            {
                var inprogressTimeEntry = item.AuditTimeEntries.FirstOrDefault(x => x.IsInprogress);
                var userName = "";
                DateTime? dateStarted = null;
                if (inprogressTimeEntry != null)
                {
                    userName = inprogressTimeEntry.USERINFO.USERNAME;
                    dateStarted = inprogressTimeEntry.StartTime;
                }

                <tr>
                    <td style="text-align:center;">
                        @serialNumberIndex.ToString()
                    </td>
                    <td>
                        @item.OrderNo
                    </td>
                    <td>
                        @item.CRN.CRNNAME
                    </td>
                    <td>
                        @item.AuditRequestType.Name
                    </td>
                    <td>
                        @item.AuditTask.Name
                    </td>
                    <td>
                        @item.DateCreated.ToString()
                    </td>
                    <td>
                        @userName
                    </td>
                    <td>
                        @(dateStarted.HasValue ? dateStarted.Value.ToString() : "")
                    </td>
                    <td>
                        @if (item.IsRushOrder)
                        {
                            <span class="priority-badge priority-rush">Rush</span>
                        }
                        else
                        {
                            <span class="priority-badge priority-normal">Normal</span>
                        }
                    </td>
                </tr>

                serialNumberIndex++;
            }
        </table>

       
    </div>
</div>