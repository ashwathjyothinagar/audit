<script>
    var sortOrders = {};

    function sortTable(columnIndex, tableName) {
        let table, rows, switching, i, x, y, shouldSwitch;
        table = document.getElementById(tableName);
        if (!table) return;
        switching = true;

        if (sortOrders[columnIndex] === undefined) {
            sortOrders[columnIndex] = 'asc';
        } else if (sortOrders[columnIndex] === 'asc') {
            sortOrders[columnIndex] = 'desc';
        } else {
            sortOrders[columnIndex] = 'asc';
        }

        let sortIcons = table.querySelectorAll('.sort-icon');
        sortIcons.forEach(icon => {
            icon.innerHTML = '';
        });

        let th = table.rows[0].getElementsByTagName("th")[columnIndex];
        let sortIcon = th ? th.querySelector('.sort-icon') : null;
        if (sortIcon) {
            let iconEl = document.createElement('i');
            iconEl.classList.add('glyphicon');
            if (sortOrders[columnIndex] === 'asc') {
                iconEl.classList.add('glyphicon-arrow-up');
            } else {
                iconEl.classList.add('glyphicon-arrow-down');
            }
            sortIcon.appendChild(iconEl);
        }

        while (switching) {
            switching = false;
            rows = table.rows;

            for (i = 1; i < (rows.length - 1); i++) {
                shouldSwitch = false;
                x = rows[i].getElementsByTagName("td")[columnIndex];
                y = rows[i + 1].getElementsByTagName("td")[columnIndex];

                if (!x || !y) continue;

                let xValue = x.innerText.trim().toLowerCase();
                let yValue = y.innerText.trim().toLowerCase();

                if (sortOrders[columnIndex] === 'asc') {
                    if (xValue > yValue) {
                        shouldSwitch = true;
                        break;
                    }
                } else {
                    if (xValue < yValue) {
                        shouldSwitch = true;
                        break;
                    }
                }
            }
            if (shouldSwitch) {
                rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
                switching = true;
            }
        }
    }
</script>
