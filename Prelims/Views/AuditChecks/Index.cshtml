@model IEnumerable<Prelims.AuditCheck>

@{
    ViewBag.PageTitle = "CHECKS";
}

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th style="width:10%">
            Name
        </th>
        <th style="width:20%">
            Tasks
        </th>
        <th>
            Offices
        </th>
        <th style="width:10%">
            Order Number Series
        </th>
        <th style="width:10%">
            Check Value List
        </th>
        <th style="width:10%"></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TaskNames)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.SelectedOfficeNames)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.OrderNumberSeries)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.AuditCheckValues)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.Id }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.Id })
        </td>
    </tr>
}

</table>
