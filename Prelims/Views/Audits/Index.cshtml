@model IEnumerable<Prelims.Audit>

@{
    ViewBag.PageTitle = "ORDERS";
}



@using (Html.BeginForm("Index", "Audits", FormMethod.Get, new { @style = "padding-bottom:10px;" }))
{
    <div class="row">
        <div class="col-lg-4">
            <label for="exampleInputName2" class="control-label">Office Name</label>
            <div>
                @Html.Partial("_OfficeSelection")
            </div>
        </div>
        <div class="col-lg-2">
            <label for="exampleInputName2" class="control-label">Task</label>
            <div>
                @Html.DropDownList("TaskId", null, htmlAttributes: new { @class = "form-control" })
            </div>
        </div>
        <div class="col-lg-2">
            <label for="exampleInputName2" class="control-label">Request Type</label>
            <div>
                @Html.DropDownList("RequestTypeId", null, "ALL", htmlAttributes: new { @class = "form-control" })
            </div>
        </div>
        <div class="col-lg-2">
            <label for="exampleInputName2" class="control-label"></label>
            <div>
                <button type="submit" class="btn btn-success" style="margin-top: 5px">Search</button>
            </div>
        </div>
        <div class="col-lg-2" >
            <div class="pull-right" style="padding-top: 34px;">
               @if (ViewBag.InprogressAuditId != null)
               {
                @Html.ActionLink("Continue", "Production", new { id = ViewBag.InprogressAuditId }, new { @class = "btn btn-danger" })
               }
            </div>
        </div>
    </div>
}

<table class="table table-striped">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.OrderNo)
        </th>
        <th>
            Office Name
        </th>
        <th>
            @Html.DisplayNameFor(model => model.PropertyAddress)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.APNNo)
        </th>
        <th>
            Requested By
        </th>
        <th>
            Requested By Email
        </th>
        <th>
            Recieved On
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AuditStatus.Name)
        </th>
        <th>Priority</th>

    </tr>
    @{
        var counter = 0;
    }
    @foreach (var item in Model)
    {
        <tr class="@( item.IsRushOrder ? "danger"  : "" )">
            <td>

                @if (ViewBag.InprogressAuditId != null)
                {
                    <span>********</span>
                }
                else if (item.TaskId == 1)
                {
                    @Html.ActionLink("******", "Production", new { id = item.Id })
                }
                else
                {
                    @Html.ActionLink(item.OrderNo, "Production", new { id = item.Id })
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CRN.CRNNAME)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PropertyAddress)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.APNNo)
            </td>
            <td>
                @if (item.AuditSender != null)
                {
                    @item.AuditSender.Name;
                }
            </td>
            <td>
                @if (item.AuditSender != null)
                {
                    @item.AuditSender.EmailAddress;
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateCreated)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AuditStatus.Name)
            </td>
            <td>
                @(item.IsRushOrder ? "RUSH" : "Normal" )
            </td>

        </tr>
        counter++;
    }

</table>
<script>
        var officeNameDropdown = document.getElementById('CrnId');

        if (officeNameDropdown) {
            officeNameDropdown.disabled = true
        }

</script>