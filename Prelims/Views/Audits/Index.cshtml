@model IEnumerable<Prelims.Audit>

@{
    ViewBag.PageTitle = "ORDERS";
}

@using (Html.BeginForm("Index", "Audits", FormMethod.Get, new { @style = "padding-bottom:10px;" }))
{
    <div class="row">
        <div class="col-lg-3">
            <label for="exampleInputName2" class="control-label">Office Name</label>
            <div>
                @Html.Partial("_OfficeSelection")
            </div>
        </div>
        <div class="col-lg-2">
            <label for="exampleInputName2" class="control-label">Task</label>
            <div>
                @Html.DropDownList("TaskId", null, htmlAttributes: new { @class = "form-control" })
            </div>
        </div>
        <div class="col-lg-2">
            <label for="exampleInputName2" class="control-label">Request Type</label>
            <div>
                @Html.DropDownList("RequestTypeId", null, "ALL", htmlAttributes: new { @class = "form-control" })
            </div>
        </div>
        <div class="col-lg-1">
            <label for="exampleInputName2" class="control-label">Page Size</label>
            <div>
                <select class="form-control col-md-2 list-box" id="PageSize" name="PageSize">
                    <option value="10" @(ViewBag.PageSize == 10 ? "selected=\"selected\"" : "")>10</option>
                    <option value="50" @(ViewBag.PageSize == 50 ? "selected=\"selected\"" : "")>50</option>
                    <option value="100" @(ViewBag.PageSize == 100 ? "selected=\"selected\"" : "")>100</option>
                    <option value="500" @(ViewBag.PageSize == 500 ? "selected=\"selected\"" : "")>500</option>
                    <option value="1000" @(ViewBag.PageSize == 1000 ? "selected=\"selected\"" : "")>1000</option>
                </select>
            </div>
        </div>
        <div class="col-lg-2">
            <label for="exampleInputName2" class="control-label"></label>
            <div>
                <button type="submit" class="btn btn-success" style="margin-top: 5px">Search</button>
                <span class="label label-info" style="margin-left: 10px; margin-top: 10px; font-size: 17px; display: inline-block; vertical-align: middle;" title="Total orders across all tasks in Audit Tracker">Total : @(ViewBag.TotalAllTasksCount ?? Model.Count())</span>
            </div>
        </div>
        <div class="col-lg-2" >
            <div class="pull-right" style="padding-top: 34px;">
               @if (ViewBag.InprogressAuditId != null)
               {
                @Html.ActionLink("Continue", "Production", new { id = ViewBag.InprogressAuditId }, new { @class = "btn btn-danger" })
               }
            </div>
        </div>
    </div>
}

<table class="table table-striped table-condensed">
    <tr>
        <th>
            Order No
        </th>
        <th>
            County
        </th>
        <th>
            Office
        </th>
        <th>
            Order Type
        </th>
        <th>
            Priority
        </th>
        <th>
            Task
        </th>
        <th>
            Received On
        </th>
        <th>
            FF Assigned Date
        </th>
        <th>
            Order Assigned To
        </th>
        <th>
            Comments
        </th>
        <th>
            TAT
        </th>
    </tr>
    @foreach (var item in Model)
    {
        <tr class="@( item.IsRushOrder ? "danger"  : "" )">
            <td>
                @if (ViewBag.InprogressAuditId != null)
                {
                    <span>********</span>
                }
                else if (item.TaskId == 1)
                {
                    @Html.ActionLink("******", "Production", new { id = item.Id })
                }
                else
                {
                    @Html.ActionLink(item.OrderNo, "Production", new { id = item.Id })
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.County)
            </td>
            <td>
                @(item.CRN != null ? item.CRN.CRNNAME : "")
            </td>
            <td>
                @(item.AuditRequestType != null ? item.AuditRequestType.Name : "")
            </td>
            <td>
                @(item.IsRushOrder ? "Rush" : "Normal")
            </td>
            <td>
                @(item.AuditTask != null ? item.AuditTask.Name : "")
            </td>
            <td>
                @(item.DateCreated.HasValue ? item.DateCreated.Value.ToString("M/d/yyyy h:mm:ss tt") : "")
            </td>
            <td>
                @(item.FFAssignedDate.HasValue ? item.FFAssignedDate.Value.ToString("M/d/yyyy h:mm:ss tt") : "")
            </td>
            <td>
                @item.UserAssignedName
            </td>
            <td>
                @(string.IsNullOrWhiteSpace(item.RushOrderComments) ? item.OrderMovementComments : item.RushOrderComments)
            </td>
            <td>
                @(item.TOT.HasValue ? item.TOT.Value.ToString("M/d/yyyy h:mm:ss tt") : "")
            </td>
        </tr>
    }
</table>

<script>
    var officeNameDropdown = document.getElementById('CrnId');

    if (officeNameDropdown) {
        officeNameDropdown.disabled = true;
    }
</script>
