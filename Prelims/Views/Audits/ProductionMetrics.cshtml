@{
    ViewBag.Title = "Production Metrics";
}

<div class="row" ng-controller="ProductionMetricsController as $ctrl" ng-init="$ctrl.init(@(ViewBag.IsManager == true ? "true" : "false"))">
    <div class="col-xs-12">
        <div class="page-title-box">
            <h4 class="page-title">Production Metrics Report</h4>
            <div class="clearfix"></div>
        </div>
    </div>

    <div class="col-xs-12">
        <div class="card-box">
            <form class="form-inline" name="reportForm">
                
                <div class="form-group m-r-10">
                    <label>Report Type: </label>
                    <select class="form-control" ng-model="$ctrl.reportType" ng-change="$ctrl.onReportTypeChange()">
                        <option value="Daily">Daily</option>
                        <option value="Monthly">Monthly</option>
                    </select>
                </div>

                <div class="form-group m-r-10">
                    <label>Start Date: </label>
                    <input type="date" class="form-control" ng-model="$ctrl.startDate">
                </div>
                
                <div class="form-group m-r-10">
                    <label>End Date: </label>
                    <input type="date" class="form-control" ng-model="$ctrl.endDate">
                </div>

                <div class="form-group m-r-10">
                    <label>Start Time: </label>
                    <input type="time" class="form-control" ng-model="$ctrl.startTime" placeholder="HH:mm">
                </div>

                <div class="form-group m-r-10">
                    <label>End Time: </label>
                    <input type="time" class="form-control" ng-model="$ctrl.endTime" placeholder="HH:mm">
                </div>
                
                <div class="form-group m-r-10">
                    <label>Offices</label>
                    <select class="form-control" multiple="multiple" id="officeSelect" ng-model="$ctrl.selectedOffices" style="min-width:200px; height: 100px;">
                        @foreach (var office in ViewBag.Offices)
                        {
                            <option value="@office.CRNID">@office.CRNNAME</option>
                        }
                    </select>
                </div>

                <div class="form-group m-r-10">
                    <label>Location</label>
                    <select class="form-control" ng-model="$ctrl.selectedLocation">
                        <option value="">-- All --</option>
                        @foreach (var loc in ViewBag.Locations)
                        {
                            <option value="@loc">@loc</option>
                        }
                    </select>
                </div>

                <button type="button" class="btn btn-primary" style="vertical-align: top;" ng-click="$ctrl.generateReport()">Generate</button>
                <button type="button" class="btn btn-success" style="vertical-align: top;" ng-click="$ctrl.exportToExcel()" ng-show="$ctrl.hasData">Export to Excel</button>
            </form>

            <!-- Targets Table -->
            <div class="panel panel-default" style="margin-top: 15px; margin-bottom: 20px;">
                <div class="panel-heading" style="background-color: #0c3559; color: #fff; font-weight: bold; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 15px;">Targets</span>
                    @if (ViewBag.IsManager == true)
                    {
                        <div>
                            <button type="button" class="btn btn-xs btn-warning" ng-if="!$ctrl.isEditingTargets" ng-click="$ctrl.editTargets()">
                                <i class="glyphicon glyphicon-edit"></i> Edit Targets
                            </button>
                            <button type="button" class="btn btn-xs btn-success" ng-if="$ctrl.isEditingTargets" ng-click="$ctrl.saveTargets()">
                                <i class="glyphicon glyphicon-ok"></i> Save Targets
                            </button>
                            <button type="button" class="btn btn-xs btn-default" ng-if="$ctrl.isEditingTargets" ng-click="$ctrl.cancelEditTargets()" style="margin-left: 5px;">
                                Cancel
                            </button>
                        </div>
                    }
                </div>
                <div class="panel-body" style="padding: 0;">
                    <table class="table table-bordered table-condensed text-center" style="margin-bottom: 0;">
                        <thead style="background-color: #0c3559; color: #fff;">
                            <tr>
                                <th style="width: 130px; text-align: center; vertical-align: middle; background-color: #07223b;"></th>
                                <th ng-repeat="t in $ctrl.targets" style="text-align: center; vertical-align: middle;">{{t.TaskName}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th style="background-color: #f4f5f7; text-align: center; vertical-align: middle;">Count</th>
                                <td ng-repeat="t in $ctrl.targets" style="vertical-align: middle;">
                                    <span ng-if="!$ctrl.isEditingTargets" style="font-weight: bold; font-size: 14px;">{{t.Count}}</span>
                                    <input type="number" class="form-control input-sm text-center" style="display:inline-block; width: 85px;" ng-if="$ctrl.isEditingTargets" ng-model="t.Count" min="1" />
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color: #f4f5f7; text-align: center; vertical-align: middle;">Time (min)</th>
                                <td ng-repeat="t in $ctrl.targets" style="vertical-align: middle;">
                                    <span ng-if="!$ctrl.isEditingTargets" style="font-weight: bold; font-size: 14px;">{{t.TimeMinutes}}</span>
                                    <input type="number" step="0.5" class="form-control input-sm text-center" style="display:inline-block; width: 85px;" ng-if="$ctrl.isEditingTargets" ng-model="t.TimeMinutes" min="0.1" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <hr />

            <div class="table-responsive" ng-show="$ctrl.hasData" style="overflow-x: auto; width: 100%;">
                <table id="metricsTable" class="table table-bordered table-striped">
                    <thead>
                        <tr style="background-color: #0c3559; color: #fff;">
                            <th style="text-align: center;">SL.No</th>
                            <th>Name</th>
                            <th style="text-align: center;">Location</th>
                            <th style="text-align: center; background-color: #07223b;">Hours Worked</th>
                            <th style="text-align: center; background-color: #07223b;">Achieved %</th>
                            <th ng-repeat="col in $ctrl.dynamicColumns" style="text-align: center;">{{col}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in $ctrl.reportData">
                            <td style="text-align: center;">{{row.SerialNumber}}</td>
                            <td>{{row.Name}}</td>
                            <td style="text-align: center;">{{row.Location}}</td>
                            <td style="font-weight: bold; text-align: center; background-color: #fff9e6; color: #b78103;">
                                {{row.HoursWorkedDisplay}}
                            </td>
                            <td ng-style="{'background-color': row.AchievedPercent >= 90 ? '#d4edda' : '#f8d7da', 'color': row.AchievedPercent >= 90 ? 'green' : 'red', 'font-weight': 'bold', 'text-align': 'center'}">
                                {{row.AchievedPercentDisplay}}
                            </td>
                            <td ng-repeat="col in $ctrl.dynamicColumns" style="text-align: center;">
                                <a href="javascript:void(0)" ng-if="row.TaskCounts[col] && row.TaskCounts[col].Count > 0" ng-click="$ctrl.showOrders(row.TaskCounts[col].OrderNumbers, row.Name, col)">
                                    {{row.TaskCounts[col].Count}}
                                </a>
                                <span ng-if="!row.TaskCounts[col] || row.TaskCounts[col].Count === 0">0</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <div ng-show="!$ctrl.hasData && $ctrl.searched">
                <p>No data found for the selected criteria.</p>
            </div>
        </div>
    </div>

    <!-- Orders Modal -->
    <div id="ordersModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">Orders for {{ $ctrl.modalUser }} ({{ $ctrl.modalTask }})</h4>
                </div>
                <div class="modal-body">
                    <table class="table table-bordered table-striped" ng-if="$ctrl.modalOrders.length > 0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Order No</th>
                                <th>Office</th>
                                <th>Product Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="order in $ctrl.modalOrders">
                                <td>{{$index + 1}}</td>
                                <td>
                                    <a ng-href="/Audits/Details?orderNo={{order.OrderNumber}}" target="_blank">{{order.OrderNumber}}</a>
                                </td>
                                <td>{{order.OfficeName}}</td>
                                <td>{{order.ProductType}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
