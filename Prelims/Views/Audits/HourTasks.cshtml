
@{
    ViewBag.Title = "HOURLY COUNT";
}
<style>
    .office-multiselect {
        border: 1px solid #f3f3f3;
        padding: 10px;
        max-width: 300px;
        overflow-y: auto;
        max-height: 300px;
    }

    .group {
        margin-bottom: 10px;
    }

        .group label {
            font-weight: bold;
        }

    .options {
        margin-left: 20px;
    }
</style>

<form name="searchForm">
    <div ng-controller="HourlyTaskReportController as $ctrl">
        <div class="row">
            <div class="col-lg-2"></div>
            <div class="col-lg-10">
                <div class="row">
                    <div class="col-lg-8">
                        <div class="form-group">
                            <label class="control-label col-md-2" for="BranchCity">Start Date</label>
                            <div class="col-md-3">
                                <input type="text" name="startDate" id="startDate" class="form-control" uib-datepicker-popup="dd/MM/yyyy" style="width: 180px" ng-model="$ctrl.startDate" ng-click="$ctrl.openStartPopup()" is-open="$ctrl.startOpened" datepicker-options="$ctrl.dateOptions" ng-required="true" close-text="Close" alt-input-formats="altInputFormats" required />
                                <span style="color: red;" ng-show="searchForm.startDate.$touched && searchForm.startDate.$error.required">Start Date is required.</span>
                            </div>
                            <div class="col-md-7">
                                <select class="form-control" id="CrnId1" name="CrnId1" style="width: 70px; display:inline;" ng-model="$ctrl.startDateHour">
                                    <option ng-repeat="option in $ctrl.hours" value="{{option}}">{{option}}</option>
                                </select>
                                <select class="form-control" id="CrnId2" name="CrnId2" style="width: 70px; display:inline;" ng-model="$ctrl.startDateMinute">
                                    <option ng-repeat="option in $ctrl.minutes" value="{{option}}">{{option}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="padding-top: 10px;">
                    <div class="col-lg-8">
                        <div class="form-group">
                            <label class="control-label col-md-2" for="BranchCity">End Date</label>
                            <div class="col-md-3">
                                <input type="text" name="endDate" id="endDate" class="form-control" uib-datepicker-popup="dd/MM/yyyy" style="width: 180px" ng-model="$ctrl.endDate" ng-click="$ctrl.openEndPopup()" is-open="$ctrl.endOpened" datepicker-options="$ctrl.dateOptions" ng-required="true" close-text="Close" alt-input-formats="altInputFormats" required />
                                <span style="color: red;" ng-show="searchForm.endDate.$touched &&searchForm.endDate.$error.required">End Date is required.</span>
                            </div>
                            <div class="col-md-7">
                                <select class="form-control" id="CrnId3" name="CrnId3" style="width: 70px; display:inline;" ng-model="$ctrl.endDateHour">
                                    <option ng-repeat="option in $ctrl.hours" value="{{option}}">{{option}}</option>
                                </select>
                                <select class="form-control" id="CrnId4" name="CrnId4" style="width: 70px; display:inline;" ng-model="$ctrl.endDateMinute">
                                    <option ng-repeat="option in $ctrl.minutes" value="{{option}}">{{option}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row" style="padding-top: 10px;">
                    <div class="col-lg-8">
                        <div class="form-group">
                            <label class="control-label col-md-2" for="BranchCity">Location - Task</label>
                            <div class="col-md-5">
                                <div class="row">
                                    <div class="col-md-6">
                                        <select name="location" id="location" class="form-control">
                                            <option value="ALL">ALL</option>
                                            <option value="BANGALORE">BANGALORE</option>
                                            <option value="CHENNAI">CHENNAI</option>
                                            <option value="HOSPET">HOSPET</option>
                                            <option value="VENDOR">VENDOR</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        @Html.DropDownList("TaskId", null, "ALL", htmlAttributes: new { @class = "form-control", ng_model = "$ctrl.taskId" })
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="row" style="padding-top: 10px;">
                    <div class="col-lg-8">
                        <div class="form-group">
                            <input type="hidden" id="SelectedOffices" name="SelectedOffices" />
                            <label class="control-label col-md-2" for="BranchCity">Office Name</label>
                            <div class="col-md-5">
                                <div id="office-multiselect" class="office-multiselect">
                                    @foreach (var group in ((List<CRN>)ViewBag.Offices).GroupBy(x => x.GroupName))
                                    {
                                        <div class="group">
                                            <label>
                                                <input type="checkbox" class="group-checkbox" data-group="@group.Key.Replace(" ", "")">
                                                @group.Key
                                            </label>
                                            <div class="options">
                                                @foreach (var office in group)
                                                {
                                                    <label><input type="checkbox" class="office-checkbox" data-group="@group.Key.Replace(" ", "")" value="@office.CRNID"> @office.CRNNAME</label>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>


                        </div>
                    </div>
                </div>

                <div class="row" style="padding-top: 10px;">
                    <div class="col-lg-8">
                        <div class="form-group">
                            <label class="control-label col-md-2" for="SenderId"></label>
                            <div class="col-md-10">
                                <input type="button" class="btn btn-success" ng-click="$ctrl.loadReport()" value="Search" ng-disabled="!searchForm.$valid" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2"></div>
        </div>
        <div class="row" ng-if="$ctrl.HourlyTaskdOrders.length > 0" style="padding-top: 10px;">
            <div class="col-lg-12" id="orderCompletedTable">
                <table class="table table-striped">
                    <tr>
                        <th>Sl No</th>
                        <th ng-repeat="headerItem in $ctrl.headerColumns">
                            {{headerItem}}
                        </th>
                        <th>
                            <div class="pull-right">
                                <i class="fa fa-file-excel-o exportToExcelButton" table-id="orderCompletedTable" title="Export to Excel" aria-hidden="true" file-name="OrderCompleted"></i>
                            </div>
                        </th>
                    </tr>
                    <tr ng-repeat="order in $ctrl.HourlyTaskdOrders">
                        <td>{{$index+1}}</td>
                        <td ng-repeat="headerItem in $ctrl.headerColumns">
                            {{ order[headerItem] }}
                        </td>
                        <td>
                        </td>
                    </tr>
                </table>
            </div>

        </div>
    </div>

    <datalist id="locations">
        <option value="BANGALORE">
        <option value="CHENNAI">
        <option value="HOSPET">
        <option value="VENDOR">
    </datalist>
</form>



