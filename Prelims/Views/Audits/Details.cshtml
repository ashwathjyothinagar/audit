<div class="row production-row">
    <div class="col-lg-6">
        <h4>Errors</h4>
        @{
            List<AuditError> titleOrderErrors = Model.Errors;

            // Group by TaskName
            var groupedErrors = titleOrderErrors
                .GroupBy(e => e.TaskName)
                .Select(group => new
                {
                    TaskName = group.Key,
                    Errors = group.ToList()
                })
                .ToList();
        }

        <table class="table">
            <thead>
                <tr>
                    <th>Task Name</th>
                    <th>Selected Category</th>
                    <th>Error Types</th>
                    <th>Comments</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in groupedErrors)
                {
                    <tr>
                        <td colspan="5"><strong>@group.TaskName</strong></td>
                    </tr>

                    foreach (var error in group.Errors)
                    {
                        <tr>
                            <td></td>
                            <td>@error.SelectedCategoryName</td>
                            <td>
                                @foreach (var errorType in error.ErrorTypes)
                                {
                                    <span> @(errorType.Name)</span> @("("+ @errorType.IsCriticalText +")" )<br />
                                }
                            </td>
                            <td>@error.Comments</td>

                        </tr>
                    }
                }
            </tbody>
        </table>

    </div>
    <div class="col-lg-6">



    </div>


</div>



