<hr />
<div class="row production-row">
    <div class="col-lg-2 production-label">
        @Html.DisplayNameFor(model => model.AuditTask.Name)
    </div>

    <div class="col-lg-2">
        @Html.DisplayFor(model => model.AuditTask.Name)
    </div>
    <div class="col-lg-2 production-label">
        @Html.DisplayNameFor(model => model.ClientInstructions)
    </div>

    <div class="col-lg-2">
        @Html.DisplayFor(model => model.ClientInstructions)
    </div>

</div>
<hr />
<div class="row production-row">
    <div class="col-lg-2 production-label">
        Priority
    </div>

    <div class="col-lg-2">
        @if (Model.IsRushOrder && Model.StatusId != 3 && Model.StatusId != 4 && Model.StatusId != 5)
        {
            <span class="label label-danger">RUSH</span> @Html.ActionLink("Make it Normal", "MakeNormal", new { orderId = Model.Id }, new { @style = "padding-left: 10px" })
        }
        else if (Model.StatusId != 3 && Model.StatusId != 4 && Model.StatusId != 5)
        {
            <span>Normal</span> @Html.ActionLink("Make it Rush", "MakeRush", new { orderId = Model.Id }, new { @style = "padding-left: 10px" })
        }
        else
        {
            @(Model.IsRushOrder ? "Rush" : "Normal")
        }
    </div>
    <div class="col-lg-2 production-label">

    </div>

    <div class="col-lg-2">
    </div>
</div>
<hr />
<div class="row production-row">
    <div class="col-lg-6">
        <table class="table table-striped">
            <tr>
                <th>
                    Task
                </th>

                <th>
                    User name
                </th>

                <th>
                    Start Time
                </th>

                <th>
                    End Time
                </th>
            </tr>
            @foreach (var item in Model.AuditTimeEntries)
            {
                <tr>
                    <td>
                        @item.AuditTask.Name
                    </td>
                    <td>
                        @item.USERINFO.USERNAME
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.StartTime)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.EndTime)
                    </td>
                </tr>
            }
        </table>
    </div>
    <div class="col-lg-6">
        <table class="table table-striped">
            <tr>
                <th>
                    Task
                </th>

                <th>
                    User name
                </th>

                <th>
                    Updates
                </th>

            </tr>
            @foreach (var item in Model.AuditUpdates)
            {
                <tr>
                    <td>
                        @item.AuditTask.Name
                    </td>
                    <td>
                        @item.USERINFO.USERNAME
                    </td>
                    <td>
                        @item.Updates
                    </td>
                </tr>
            }
        </table>
    </div>
</div>
