
@model IEnumerable<Prelims.Audit>

    @{
    ViewBag.PageTitle = "SEARCH ORDER";
    }



    @using (Html.BeginForm("SearchOrder", "Audits", FormMethod.Get, new { @style = "padding-bottom:10px;" }))
    {
    <div class="row">
        <div class="col-lg-2">
            <label for="exampleInputName2" class="control-label">Order No</label>
            <div>
                <input type="text" id="OrderNo" name="OrderNo" class="form-control" value="@ViewBag.OrderNo" />
            </div>
        </div>
        <div class="col-lg-2">
            <label for="exampleInputName2" class="control-label"></label>
            <div>
                <button type="submit" class="btn btn-success" style="margin-top: 5px">Search</button>
            </div>
        </div>
    </div>
    }

    <table class="table table-striped">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OrderNo)
            </th>
            <th>
                Office Name
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PropertyAddress)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.APNNo)
            </th>
            <th>
                Requested By
            </th>
            <th>
                Recieved On
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AuditStatus.Name)
            </th>


        </tr>

        @foreach (var item in Model)
        {
        <tr>
            <td>
                @Html.ActionLink(item.OrderNo, "Details", new { id = item.Id })
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CRN.PolicyKeyDisplayName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PropertyAddress)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.APNNo)
            </td>
            <td>
                @if (item.AuditSender != null)
                {
                @item.AuditSender.Name;
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateCreated)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AuditStatus.Name)
            </td>
        </tr>
        }

    </table>



